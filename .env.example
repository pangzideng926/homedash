# ==============================================================================
# homedash 环境变量示例（请复制为 .env 后按需填写，切勿将真实 .env 提交到仓库）
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 应用基础配置（app）
# ------------------------------------------------------------------------------
# 服务监听端口与地址
PORT=3000
HOST=0.0.0.0
# 运行环境：development | production | test
NODE_ENV=development
# SQLite 数据库路径
DATABASE_URL=file:./data/homedash.db
# 生产环境托管的前端构建产物目录（可选，默认 ../web/dist）
# WEB_DIST_DIR=../web/dist

# 是否为会话 Cookie 开启 Secure 属性（留空时生产环境默认开启，开发环境默认关闭）
# 局域网内用纯 HTTP 访问生产环境（含 Docker 部署）时，请取消下一行注释，否则无法保持登录
# COOKIE_SECURE=false

# 是否信任反向代理传入的 X-Forwarded-For 请求头（默认 false，仅在部署于可信反代后时设为 true）
TRUST_PROXY=false
# 展示日期与到期提醒计算使用的 IANA 时区（默认 Asia/Shanghai）
TZ_DISPLAY=Asia/Shanghai
# 本地加密集成凭据文件路径（可选，用于通过网页 /settings 保存 NAS / qBittorrent / MoviePilot 配置）
# INTEGRATIONS_FILE=./secrets/integrations.json
# 集成凭据加密密钥（可选，至少 32 个字符；未设置时使用 SESSION_SECRET 通过 HKDF-SHA256 派生）
# CONFIG_ENCRYPTION_KEY=请填写至少32位随机字符作为集成凭据加密密钥

# ------------------------------------------------------------------------------
# 2. 认证与会话配置（auth，必填项缺失或格式错误将阻止服务启动）
# ------------------------------------------------------------------------------
# 管理员登录用户名（必填）
ADMIN_USERNAME=admin
# 管理员密码哈希（必填，请使用 pnpm --filter server hash-password <密码> 生成）
ADMIN_PASSWORD_HASH=请填写_scrypt_密码哈希
# 会话签名密钥（必填，至少 32 个随机字符）
SESSION_SECRET=请填写至少32位随机字符作为会话签名密钥
# 会话有效期（小时，默认 168 即 7 天）
SESSION_TTL_HOURS=168
# 单 IP 连续登录失败触发锁定的次数上限（默认 5）
LOGIN_MAX_ATTEMPTS=5
# 登录触发限流后的锁定时长（分钟，默认 15）
LOGIN_LOCK_MINUTES=15

# ------------------------------------------------------------------------------
# 3. 可选采集模块（NAS / qBittorrent / MoviePilot 可在 .env 或网页 /settings 配置；.env 优先级更高）
# ------------------------------------------------------------------------------

# [NAS] SSH 只读采集配置与受限 Docker 操作配置（可选）
# NAS_SSH_HOST=192.0.2.10
# NAS_SSH_PORT=22
# NAS_SSH_USER=demo
# NAS_SSH_KEY_PATH=./secrets/nas_id_ed25519
# 开发/演示模拟数据开关（设为 true 时返回模拟 Debian 12 NAS 状态）
# NAS_MOCK=false
# 成功状态缓存时间（秒，默认 30）
# NAS_CACHE_SECONDS=30
# 是否允许通过网页执行受限 Docker 容器操作（start/stop/restart，默认 false）
# DOCKER_ACTIONS_ENABLED=false
# 受保护容器名列表（逗号分隔，禁止 stop/restart，默认 homedash）
# DOCKER_PROTECTED_CONTAINERS=homedash
# Docker 容器操作审计日志文件路径（JSON Lines，默认 ./data/docker-audit.log）
# DOCKER_AUDIT_FILE=./data/docker-audit.log
# Docker 容器 start/stop/restart 操作命令超时时间（毫秒，范围 5000..300000，默认 60000）
# DOCKER_ACTION_TIMEOUT_MS=60000

# [下载器] 多实例下载器（qBittorrent / Transmission）只读采集参数（实例清单通过 /settings 加密保存）
# 开发/演示模拟数据开关（设为 true 时返回 qB 下载、qB 刷流、TR 保种 3 个模拟实例）
# DOWNLOADERS_MOCK=false
# 单实例成功状态缓存时间（秒，默认 10，兼容 QBIT_CACHE_SECONDS）
# DOWNLOADER_CACHE_SECONDS=10
# 请求超时时间（毫秒，默认 8000，兼容 QBIT_TIMEOUT_MS）
# DOWNLOADER_TIMEOUT_MS=8000

# [qBittorrent（旧版兼容）] WebUI API v2 只读采集配置（可选；未配置 downloaders 数组时自动迁移为 qbittorrent-default）
# QBIT_URL=http://192.0.2.10:8080
# QBIT_USERNAME=demo
# QBIT_PASSWORD=请填写qBittorrent密码
# 开发/演示模拟数据开关（设为 true 时兼容等效于 DOWNLOADERS_MOCK=true）
# QBIT_MOCK=false
# 成功状态缓存时间（秒，默认 10）
# QBIT_CACHE_SECONDS=10
# 请求超时时间（毫秒，默认 8000）
# QBIT_TIMEOUT_MS=8000

# [MoviePilot] v3 API 只读采集配置（可选）
# MOVIEPILOT_URL=https://moviepilot.example.com
# MOVIEPILOT_API_TOKEN=请填写MoviePilot_API令牌
# 开发/演示模拟数据开关（设为 true 时返回模拟订阅、入库与站点状态）
# MOVIEPILOT_MOCK=false
# 成功状态缓存时间（秒，默认 60）
# MOVIEPILOT_CACHE_SECONDS=60
# 请求超时时间（毫秒，默认 8000）
# MOVIEPILOT_TIMEOUT_MS=8000

# [家用设备] 多设备 SSH 只读采集配置（支持 Windows / macOS / Linux，可参考根目录 devices.example.json）
# DEVICES_FILE=./secrets/devices.json
# 是否启用家用设备清单只读模式（设为 true 时禁止前端编辑与 PUT /api/devices 写入）
# DEVICES_READONLY=false
# 开发/演示模拟数据开关（设为 true 时返回模拟 Windows 与 macOS 设备状态）
# DEVICES_MOCK=false
# 连接、识别与采集命令超时时间（毫秒，默认 8000）
# DEVICE_SSH_TIMEOUT_MS=8000
# 成功状态缓存时间（秒，默认 30；失败固定短暂缓存 10 秒）
# DEVICE_CACHE_SECONDS=30

# [家用 Windows 主机（旧版兼容）] 未配置 DEVICES_FILE 时将自动迁移为只读“Windows 设备”
# WIN_SSH_HOST=192.0.2.20
# WIN_SSH_PORT=22
# WIN_SSH_USER=请填写Windows用户名
# WIN_SSH_KEY_PATH=./secrets/win_id_ed25519
# 连接与采集命令超时时间（毫秒，默认 8000，兼容 DEVICE_SSH_TIMEOUT_MS）
# WIN_SSH_TIMEOUT_MS=8000
# 成功状态缓存时间（秒，默认 30，兼容 DEVICE_CACHE_SECONDS）
# WIN_CACHE_SECONDS=30
# 开发/演示模拟数据开关（设为 true 时兼容等效于 DEVICES_MOCK=true）
# WIN_MOCK=false

# [VPS] 本地 VPS 清单 JSON 文件路径（可选，可参考根目录 vps.example.json）
# VPS_LIST_FILE=./secrets/vps.json
# 是否启用 VPS 清单只读模式（设为 true 时禁止前端编辑与 PUT /api/vps 写入）
# VPS_READONLY=false
