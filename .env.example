# 服务监听配置
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# 管理员账号（密码请使用 pnpm --filter server hash-password <密码> 生成哈希）
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=请用 pnpm --filter server hash-password 生成

# 会话签名密钥（至少 32 个随机字符）
SESSION_SECRET=change-me-to-a-random-string-at-least-32-chars

# SQLite 数据库路径
DATABASE_URL=file:./data/homedash.db

# 是否为会话 Cookie 开启 Secure 属性（留空时生产环境默认开启，开发环境默认关闭）
# COOKIE_SECURE=true

# 生产环境托管的前端构建产物目录（默认 ../web/dist）
# WEB_DIST_DIR=../web/dist
